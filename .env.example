# GEMINI_API_KEY: Optional in this app; automatically injected if configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected at runtime.
APP_URL="MY_APP_URL"

# SUPABASE: Optional external Supabase project credentials.
# When provided, the backend and client persist data directly in Supabase.
# When omitted, the built-in Express backend persists data locally in data/db.json.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ADMIN AUTH: Credentials for the browser admin panel (/admin).
ADMIN_EMAIL="admin@graudetails.com.br"
ADMIN_PASSWORD="GrauDetails2026"
SESSION_SECRET="grau-details-session-secret-change-in-production"
